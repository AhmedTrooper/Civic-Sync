# ==============================================================================
# CIVIC SYNC ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to '.env' (which is ignored by Git) to customize local setup.
# ==============================================================================

# --- GENERAL BACKEND SERVICE CONFIGURATION ---
# Port the Axum backend binds to (defaults to 8080 if not set)
PORT=8080

# Logging level for Axum backend (error, warn, info, debug, trace)
RUST_LOG=info

# --- SECURITY & CORS ---
# Comma-separated list of allowed origins. Leave blank to allow any origin (*) in development.
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://my-front-end.railway.app
ALLOWED_ORIGINS=

# --- POSTGRESQL DATABASE CONFIGURATION (Railway provisioning ready) ---
# Connection URL format for PostgreSQL database
# Matching local docker-compose setup:
DATABASE_URL=postgresql://civic_sync_user:civic_sync_password@localhost:5432/civic_sync_db

# --- REDIS CONFIGURATION (Railway provisioning ready) ---
# Redis cache connection host/URI
# Matching local docker-compose setup:
REDIS_URL=redis://localhost:6379

# --- MINIO / S3 STORAGE CONFIGURATION ---
# S3 credentials and endpoint configuration
# Matching local docker-compose setup:
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=supersecretpassword
S3_BUCKET=civic-sync-bucket

# --- AI ORCHESTRATION (provider-agnostic) ---
# Any AI provider supported by rig-core 0.39 is acceptable here
# (openai, bedrock, cohere, gemini, anthropic, ollama, ...).
# If ANY of these three is set, ALL three must be set or startup fails —
# there is no implicit default per provider.
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-...

# --- DISPATCH BEHAVIOUR ---
# Autopilot Mode: the 30-second trigger driver auto-applies the dispatch
# plan (resources get attached, incidents flip to DISPATCHED) instead of
# waiting for POST /api/v1/dispatch/apply. Defaults to true; set false for
# strict human-in-the-loop operation.
AUTOPILOT=true

# Background disaster generator (§5D): starts paused unless set to true.
SIMULATION_AUTOSTART=false
